# Bildmaterial und Schriften gehoeren NICHT ins Repository.
# Beides ist Ulisses-Material unter der Scriptorium-Vereinbarung und mit
# Apache 2.0 nicht vereinbar. Siehe README.md, Abschnitt "Warum keine
# Grafiken im Projekt".
grafiken/*
!grafiken/.gitkeep

# Eine Ausnahme: das Titelbild der Beispiele ist kein Ulisses-Material,
# sondern eine KI-erzeugte Illustration dieses Projekts. Sie liegt hier,
# damit ein Umschlag nach dem Klonen ein Bild hat.
!grafiken/titelbild.jpg

schriften/*
!schriften/.gitkeep

# LaTeX-Zwischenstaende
*.aux
*.log
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk
*.xdv
beispiel/*.pdf

# Python
__pycache__/
*.pyc

# Persoenliche Claude-Code-Einstellungen (Plugins, Berechtigungen)
.claude/settings.local.json

# Solo: Zwischenstaende des Werkzeugs. Die Messdatei und die
# Nummernzuordnung werden bei jedem Lauf neu erzeugt, und solo-aus/ haelt
# die bytegetreu geteilten Bloecke -- alles abgeleitet, nichts davon
# gehoert versioniert.
*.solo
*.solonummern
beispiel/solo-aus/
beispiel/*/solo-aus/

# Der Bauordner der klickbaren Fassung. Dort landen aux, log und das PDF
# des zweiten Satzlaufs; das Ergebnis kopiert das Bauskript daneben.
*-klickbar-bau/

# Testdaten aus fremder Quelle: nur zum Lasttest des Loesers und zum
# Messen des Layouts, kein Material dieses Projekts.
beispiel/solo-test/

# Der Lasttest haengt an den fremden Testdaten und ist ohne sie nicht
# lauffaehig.
beispiel/solo-test.tex
